<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">


<hibernate-configuration>
    <session-factory>
        <!-- 1. Database Connection Properties -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/bloodbank_db</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">Pajju#123</property>

        <!-- 2. Hibernate Behavioral Properties -->
        <!-- Database dialect matches your SQL vendor -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>

        <!-- Echo all executed SQL to stdout (Useful for debugging) -->
        <property name="hibernate.show_sql">true</property>

        <!-- Format the logged SQL to make it readable -->
        <property name="hibernate.format_sql">true</property>

        <!-- Automatically validate or export schema DDL on startup -->
        <!-- Options: validate, update, create, create-drop -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- 3. Resource Mapping -->
        <!-- If using XML mapping files -->
        <!--        <mapping resource="com.xworkz.bloodbanks.entity.HospitalEntity"/>-->
        <!--        <mapping resource="com.xworkz.bloodbanks.entity.BloodStockEntity"/>-->

        <!--        <mapping resource="com.xworkz.bloodbanks.entity.AcceptorEntity"/>-->

        <!--        <mapping resource="com.xworkz.bloodbanks.entity.DonarEntity"/>-->


        <!-- If using Annotated Classes -->
       <mapping class="com.xworkz.bloodapp.entity.UserEntity"/>


    </session-factory>
</hibernate-configuration>